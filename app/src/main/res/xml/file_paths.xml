<?xml version="1.0" encoding="utf-8"?>
<!-- Nur die Ordner, in die ReportSharer und LogExporter ihre fertigen Dateien
     schreiben. Die laufenden Logdateien selbst werden bewusst nicht freigegeben. -->
<paths>
    <!-- Excel-Report (cacheDir/reports) für Outlook -->
    <cache-path name="reports" path="reports/" />
    <!-- Diagnoseprotokoll für die IT -->
    <cache-path name="shared-logs" path="shared-logs/" />
</paths>
